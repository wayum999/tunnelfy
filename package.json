{
  "name": "tunnelfy",
  "displayName": "Tunnelfy",
  "description": "Manage Cloudflare tunnels from this VS Code extension. Streamline your development workflow by controlling your persistent and quick tunnels without leaving the IDE.",
  "version": "0.2.0",
  "publisher": "Willbot",
  "icon": "images/icon.png",
  "galleryBanner": {
    "color": "#1D4ED8",
    "theme": "dark"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/wayum999/tunnelfy.git"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "activationEvents": [
    "onView:tunnelfy-profiles",
    "onView:tunnelfy-tunnels",
    "onView:tunnelfy-quick-tunnels"
  ],
  "categories": [
    "Other"
  ],
  "keywords": [
    "cloudflare",
    "cloudflared",
    "tunnel",
    "cloudflare tunnel",
    "quick tunnel",
    "trycloudflare",
    "zero trust",
    "localhost",
    "port forwarding",
    "docker"
  ],
  "main": "./dist/extension.js",
  "files": [
    "dist/extension.js",
    "images/icon.png",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "tunnelfy-explorer",
          "title": "Tunnelfy",
          "icon": "$(cloud)"
        }
      ]
    },
    "configuration": {
      "title": "Tunnelfy",
      "properties": {
        "tunnelfy.autoRefreshEnabled": {
          "type": "boolean",
          "default": true,
          "description": "Enable automatic refresh of tunnel status"
        },
        "tunnelfy.autoRefreshInterval": {
          "type": "number",
          "default": 30,
          "minimum": 5,
          "maximum": 300,
          "description": "Interval in seconds between automatic refreshes (min: 5s, max: 300s)"
        },
        "tunnelfy.checkCloudflared": {
          "type": "boolean",
          "default": true,
          "description": "Check for cloudflared installation before starting a tunnel. Disable this if you have cloudflared installed in a custom location."
        }
      }
    },
    "viewsWelcome": [
      {
        "view": "tunnelfy-profiles",
        "contents": "No profiles found. [Create a profile](command:tunnelfy.createProfile)"
      },
      {
        "view": "tunnelfy-tunnels",
        "contents": "No tunnels found. [Create a tunnel](command:tunnelfy.createTunnel)"
      },
      {
        "view": "tunnelfy-quick-tunnels",
        "contents": "No quick tunnels found. [Create a quick tunnel](command:tunnelfy.createQuickTunnel)"
      }
    ],
    "views": {
      "tunnelfy-explorer": [
        {
          "type": "tree",
          "id": "tunnelfy-profiles",
          "name": "Profiles",
          "icon": "$(account)",
          "when": "true"
        },
        {
          "type": "tree",
          "id": "tunnelfy-tunnels",
          "name": "Persistent Tunnels",
          "icon": "$(cloud)",
          "when": "true"
        },
        {
          "type": "tree",
          "id": "tunnelfy-quick-tunnels",
          "name": "Quick Tunnels",
          "icon": "$(zap)",
          "when": "true"
        }
      ]
    },
    "menus": {
      "commandPalette": [
        {
          "command": "tunnelfy.changeApiKey",
          "when": "false"
        },
        {
          "command": "tunnelfy.copyQuickTunnelUrl",
          "when": "false"
        }
      ],
      "view/title": [
        {
          "command": "tunnelfy.createProfile",
          "when": "view == tunnelfy-profiles",
          "group": "navigation@1"
        },
        {
          "command": "tunnelfy.refreshProfiles",
          "when": "view == tunnelfy-profiles",
          "group": "navigation@2"
        },
        {
          "command": "tunnelfy.generateService",
          "when": "view == tunnelfy-tunnels",
          "group": "navigation@1"
        },
        {
          "command": "tunnelfy.createTunnel",
          "when": "view == tunnelfy-tunnels",
          "group": "navigation@2"
        },
        {
          "command": "tunnelfy.refreshTunnels",
          "when": "view == tunnelfy-tunnels",
          "group": "navigation@3"
        },
        {
          "command": "tunnelfy.createQuickTunnel",
          "when": "view == tunnelfy-quick-tunnels",
          "group": "navigation@1"
        },
        {
          "command": "tunnelfy.refreshQuickTunnels",
          "when": "view == tunnelfy-quick-tunnels",
          "group": "navigation@2"
        }
      ],
      "view/item/context": [
        {
          "command": "tunnelfy.changeApiKey",
          "when": "view == tunnelfy-profiles && (viewItem == profile-active || viewItem == profile-inactive)",
          "group": "inline@2"
        },
        {
          "command": "tunnelfy.setActiveProfile",
          "when": "view == tunnelfy-profiles && viewItem == profile-inactive",
          "group": "inline@3"
        },
        {
          "command": "tunnelfy.deleteProfile",
          "when": "view == tunnelfy-profiles && (viewItem == profile-active || viewItem == profile-inactive)",
          "group": "inline@1"
        },
        {
          "command": "tunnelfy.startTunnel",
          "when": "view == tunnelfy-tunnels && viewItem =~ /^tunnel-stopped(-remote)?$/",
          "group": "inline@6"
        },
        {
          "command": "tunnelfy.stopTunnel",
          "when": "view == tunnelfy-tunnels && viewItem =~ /^tunnel-(running|stopped)(-remote)?-owned$/",
          "group": "inline@5"
        },
        {
          "command": "tunnelfy.copyToken",
          "when": "view == tunnelfy-tunnels && viewItem =~ /^tunnel-(running|stopped)(-remote)?(-owned)?$/",
          "group": "inline@4"
        },
        {
          "command": "tunnelfy.deleteTunnel",
          "when": "view == tunnelfy-tunnels && viewItem =~ /^tunnel-stopped(-remote)?(-owned)?$/",
          "group": "inline@1"
        },
        {
          "command": "tunnelfy.copyQuickTunnelUrl",
          "when": "view == tunnelfy-quick-tunnels && viewItem == quickTunnel",
          "group": "inline@1"
        },
        {
          "command": "tunnelfy.stopQuickTunnel",
          "when": "view == tunnelfy-quick-tunnels && viewItem == quickTunnel",
          "group": "inline@2"
        }
      ]
    },
    "commands": [
      {
        "command": "tunnelfy.createProfile",
        "title": "Create Profile",
        "category": "Tunnelfy",
        "icon": "$(add)",
        "description": "Create a new Cloudflare profile with an API key"
      },
      {
        "command": "tunnelfy.changeApiKey",
        "title": "Change API Key",
        "category": "Tunnelfy",
        "icon": "$(key)",
        "description": "Change the API key for an existing profile"
      },
      {
        "command": "tunnelfy.deleteProfile",
        "title": "Delete Profile",
        "category": "Tunnelfy",
        "icon": "$(trash)",
        "description": "Delete a Cloudflare profile"
      },
      {
        "command": "tunnelfy.setActiveProfile",
        "title": "Set Active Profile",
        "category": "Tunnelfy",
        "icon": "$(check)",
        "description": "Set a profile as active"
      },
      {
        "command": "tunnelfy.copyToken",
        "title": "Copy Token",
        "category": "Tunnelfy",
        "icon": "$(copy)",
        "description": "Copy tunnel token to clipboard"
      },
      {
        "command": "tunnelfy.createTunnel",
        "title": "Create Tunnel",
        "category": "Tunnelfy",
        "icon": "$(add)",
        "description": "Create a new permanent tunnel"
      },
      {
        "command": "tunnelfy.startTunnel",
        "title": "Start Tunnel",
        "category": "Tunnelfy",
        "icon": "$(play)",
        "description": "Start a tunnel"
      },
      {
        "command": "tunnelfy.deleteTunnel",
        "title": "Delete Tunnel",
        "category": "Tunnelfy",
        "icon": "$(trash)",
        "description": "Delete a tunnel"
      },
      {
        "command": "tunnelfy.stopTunnel",
        "title": "Stop Tunnel",
        "category": "Tunnelfy",
        "icon": "$(stop)",
        "description": "Stop a running tunnel"
      },
      {
        "command": "tunnelfy.createQuickTunnel",
        "title": "Create Quick Tunnel",
        "category": "Tunnelfy",
        "icon": "$(add)",
        "description": "Create a new quick tunnel"
      },
      {
        "command": "tunnelfy.stopQuickTunnel",
        "title": "Stop Quick Tunnel",
        "category": "Tunnelfy",
        "icon": "$(stop)",
        "description": "Stop a running quick tunnel"
      },
      {
        "command": "tunnelfy.copyQuickTunnelUrl",
        "title": "Copy Quick Tunnel URL",
        "category": "Tunnelfy",
        "icon": "$(copy)",
        "description": "Copy the quick tunnel URL to clipboard"
      },
      {
        "command": "tunnelfy.refreshTunnels",
        "title": "Refresh Tunnels",
        "category": "Tunnelfy",
        "icon": "$(refresh)",
        "description": "Refresh the list of tunnels"
      },
      {
        "command": "tunnelfy.refreshProfiles",
        "title": "Refresh Profiles",
        "category": "Tunnelfy",
        "icon": "$(refresh)",
        "description": "Refresh the list of profiles"
      },
      {
        "command": "tunnelfy.refreshQuickTunnels",
        "title": "Refresh Quick Tunnels",
        "category": "Tunnelfy",
        "icon": "$(refresh)",
        "description": "Refresh the list of quick tunnels"
      },
      {
        "command": "tunnelfy.generateService",
        "title": "Generate Service",
        "category": "Tunnelfy",
        "icon": "$(file-code)",
        "description": "Generate service configuration files for this tunnel"
      },
      {
        "command": "tunnelfy.generateDockerCompose",
        "title": "Generate Docker Compose Service",
        "category": "Tunnelfy",
        "icon": "$(file-code)",
        "description": "Generate a Docker Compose service for this tunnel"
      },
      {
        "command": "tunnelfy.generateSystemService",
        "title": "Generate System Service",
        "category": "Tunnelfy",
        "icon": "$(file-symlink-file)",
        "description": "Generate a system service file for this tunnel"
      },
      {
        "command": "tunnelfy.showCloudflaredInstallInstructions",
        "title": "Show cloudflared Install Instructions",
        "category": "Tunnelfy",
        "description": "Check for cloudflared and show installation instructions"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run package-extension",
    "compile": "node esbuild.js",
    "package-extension": "node esbuild.js --production",
    "watch": "node esbuild.js --watch",
    "cleanup-vscode-test": "rimraf .vscode-test",
    "clean-test-all": "node scripts/cleanup-test-dirs.js",
    "pretest": "npm run clean-tests && npm run cleanup-test-data && npm run cleanup-vscode-test && npm run compile && npm run compile-tests",
    "clean-tests": "rimraf out/test",
    "cleanup-test-data": "rimraf /tmp/tf",
    "compile-tests": "tsc -p ./src/test/tsconfig.json",
    "test": "vscode-test",
    "test-clean": "npm run clean-test-all && npm run compile && npm run compile-tests && vscode-test",
    "direct-test": "npm run clean-tests && npm run compile && npm run compile-tests && node ./out/test/test/runTest.js",
    "passing-only": "npm run pretest && node scripts/runOnlyPassingTests.js",
    "test-subset": "npm run pretest && node -e \"require('child_process').execSync('npx vscode-test --testFiles=\\\"tunnelTreeView,tunnelManager,tunnelConfig,treeViews,messages,baseCloudflareService\\\"', {stdio: 'inherit'})\"",
    "debug": "vscode-test --debug",
    "passing-tests": "npm run pretest && node scripts/runPassingTests.js",
    "test-explorer": "npm run clean-tests && npm run compile && npm run compile-tests && vscode-test",
    "test-coverage": "nyc npm run test",
    "lint": "eslint src",
    "package": "vsce package",
    "publish": "vsce publish"
  },
  "devDependencies": {
    "@istanbuljs/nyc-config-typescript": "^1.0.2",
    "@types/chai": "^5.0.1",
    "@types/glob": "^8.1.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "18.x",
    "@types/proxyquire": "^1.3.31",
    "@types/sinon": "^17.0.3",
    "@types/vscode": "^1.85.0",
    "@typescript-eslint/eslint-plugin": "^8.24.1",
    "@typescript-eslint/parser": "^8.24.1",
    "@vscode/test-cli": "^0.0.10",
    "@vscode/test-electron": "^2.4.1",
    "chai": "^5.1.2",
    "esbuild": "^0.25.0",
    "eslint": "^8.56.0",
    "glob": "^10.4.5",
    "mocha": "^10.8.2",
    "nyc": "^15.1.0",
    "proxyquire": "^2.1.3",
    "rimraf": "^6.0.1",
    "sinon": "^19.0.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3"
  }
}
